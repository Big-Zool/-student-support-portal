# Copy to .env and fill in values from Supabase dashboard → Project Settings → API

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Local development (run `cd worker && npm run dev` first):
VITE_API_BASE_URL=http://localhost:8787/api

# Production / deployed Worker (requires SUPABASE_SERVICE_ROLE_KEY set in Cloudflare):
# VITE_API_BASE_URL=https://your-worker.workers.dev/api
